#!
filesystem access & ops
!#

#*
wraps a path in a file handle table
mode is optional, defaults to "r": "r" opens an existing path, "w" creates or truncates a file, "a" creates or keeps a file
use `file.close()` when you're done with the handle
*#
pub declare fs.open = fn(path: string, mode: string?) -> !table

#* returns table of directory entries *#
pub declare fs.readdir = fn(path: string) -> !table

#* returns table of directory entries for the dir handle's path *#
pub declare file.readdir = fn(self: table) -> !table

#* does path exist? answers :false when missing, raises on unexpected io errors *#
pub declare fs.exists? = fn(path: string) -> bool

#*
removes a file or directory at path
recursive is optional, defaults to :false: removes a file or empty directory only, :true deletes the whole tree
*#
pub declare fs.remove = fn(path: string, recursive: bool?) -> !atom

#* creates a directory; parents optional, defaults to :false: :true creates missing parents like `mkdir -p`. permissions optional, platform default when omitted *#
pub declare fs.mkdir = fn(path: string, parents: bool?, permissions: num?) -> !atom

#* ensures a file exists, creating it empty when missing and leaving existing entries alone *#
pub declare fs.touch = fn(path: string) -> !atom

#* copies a file to a new path, overwriting the destination *#
pub declare fs.copy = fn(src: string, dst: string) -> !atom

#* renames a file or directory *#
pub declare fs.rename = fn(old_path: string, new_path: string) -> !atom

#* reads the full file contents as a string *#
pub declare file.read = fn(self: table) -> !string

#*
overwrites the file with the provided string, or appends when append is :true
optional permissions default to the platform file default
*#
pub declare file.write = fn(self: table, data: string, append: bool?, permissions: num?) -> !num

#* get file metadata as a table; follow optional, defaults to :true: :false leaves symlinks alone *#
pub declare file.stat = fn(self: table, follow: bool?) -> !table

#*
closes a file handle table
this is currently a logical close for wrapper handles
*#
pub declare file.close = fn(self: table) -> !atom

#* get file metadata as a table from a path; follow optional, defaults to :true *#
pub declare fs.stat = fn(path: string, follow: bool?) -> !table
