#!
statistics functions
!#

#*
counts frequencies of elements in an array table and returns a mapping of elements to their counts
*#
pub declare stats.frequencies = fn(input: table<any>) -> table<any, int>

#*
calculates the arithmetic mean of an array of numbers
*#
pub declare stats.mean = fn(input: table<num>) -> num

#*
calculates the geometric mean of an array of numbers
*#
pub declare stats.geomean = fn(input: table<num>) -> num

#*
middle value of input data
*#
pub declare stats.median = fn(input: table<num>) -> num

#*
most frequent occuring value of input data
*#
pub declare stats.mode = fn(input: table<any>) -> num

#*
population variance of the input data
*#
pub declare stats.variance = fn(input: table<num>) -> num

#*
sample variance of the input data
*#
pub declare stats.sample_variance = fn(input: table<num>) -> num

#*
population standard deviation of the input data
*#
pub declare stats.stdev = fn(input: table<num>) -> num

#*
sample standard deviation of the input data
*#
pub declare stats.sample_stdev = fn(input: table<num>) -> num

#*
population skewness of the input data
*#
pub declare stats.skewness = fn(input: table<num>) -> num

#*
sample skewness of the input data
*#
pub declare stats.sample_skewness = fn(input: table<num>) -> num

#*
population kurtosis of the input data
*#
pub declare stats.kurtosis = fn(input: table<num>) -> num

#*
sample kurtosis of the input data
*#
pub declare stats.sample_kurtosis = fn(input: table<num>) -> num

#*
table of all statistics of the input data
*#
pub declare stats.statistics = fn(input: table<num>) -> table

#*
slope of the regression of the input data
*#
pub declare stats.slope = fn(input1: table<num>, input2: table<num>) -> num

#*
intercept of the regression of the input data
*#
pub declare stats.intercept = fn(input1: table<num>, input2: table<num>) -> num

#*
correlation coefficient of the input data
*#
pub declare stats.correlation = fn(input1: table<num>, input2: table<num>) -> num

#*
population covariance of the input data
*#
pub declare stats.covariance = fn(input1: table<num>, input2: table<num>) -> num

#*
sample covariance of the input data
*#
pub declare stats.sample_covariance = fn(input1: table<num>, input2: table<num>) -> num

#*
table of regression statistics of the input data
*#
pub declare stats.regression = fn(input1: table<num>, input2: table<num>) -> table
